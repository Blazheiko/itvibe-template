# API origin. Leave empty in dev: requests go same-origin through the Vite proxy.
# Set it only when the API lives on another origin (CORS must allow it).
VITE_BASE_URL=
# Must match the backend API_PATH_PREFIX (default api)
VITE_API_PATH_PREFIX=
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=
