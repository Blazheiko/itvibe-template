{
    "name": "frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" -- && npm run build-sw",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "build-only": "vite build",
        "build-sw": "vite build --config vite.sw.config.ts",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix",
        "format": "prettier --write src/"
    },
    "dependencies": {
        "@khmyznikov/pwa-install": "^0.7.0",
        "@sentry/vue": "^10.76.2",
        "@vueuse/core": "^14.4.0",
        "dompurify": "^3.4.17",
        "marked": "^17.0.6",
        "mitt": "^3.0.1",
        "pinia": "^3.0.4",
        "shared": "workspace:*",
        "vue": "^3.5.44",
        "vue-advanced-cropper": "^2.8.9",
        "vue-i18n": "^11.4.14",
        "vue-router": "^4.6.4",
        "wavesurfer.js": "^7.12.12"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tsconfig/node22": "^22.0.6",
        "@types/jsdom": "^21.1.7",
        "@types/node": "^22.20.5",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^9.39.5",
        "eslint-plugin-playwright": "^2.12.1",
        "eslint-plugin-vue": "~10.0.1",
        "jiti": "^2.7.0",
        "jsdom": "^26.1.0",
        "npm-run-all2": "^8.0.4",
        "prettier": "3.5.3",
        "typescript": "6.0.3",
        "vite": "^6.4.4",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^4.1.12",
        "vue-tsc": "^2.2.12"
    }
}
