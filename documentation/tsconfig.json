{
    "extends": "../tsconfig.base.json",
    "include": [".vitepress/**/*.ts", ".vitepress/**/*.vue"],
    "exclude": [".vitepress/cache", ".vitepress/dist"],
    "compilerOptions": {
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "lib": ["ES2022", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node", "vitepress/client"]
    }
}
